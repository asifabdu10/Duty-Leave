# Option 1 (Google Gemini): Get a free Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE

# Option 2 (Groq - Recommended for high traffic: 14,400 free requests/day):
# Get a 100% free API key with NO credit card required from https://console.groq.com/keys
GROQ_API_KEY=PASTE_YOUR_GROQ_API_KEY_HERE

PORT=3001

# Optional: Set this only if your frontend is hosted separately from your backend
# VITE_API_URL=


